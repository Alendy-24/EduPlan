# Opcional. npm run dev desde la raíz no necesita este archivo.
# Token Socrata para cuotas autenticadas (también puede exportarse en el shell).
# SOCRATA_APP_TOKEN=
# Solo al ejecutar integración por separado; el arranque raíz fija 3001.
# PORT=3001
# Origen permitido para instituciones en un despliegue con CORS.
# FRONTEND_ORIGIN=https://eduplan.example.org
