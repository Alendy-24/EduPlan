# Base externa / backend ejecutado manualmente. No se carga con npm run dev.
# Exporta las tres variables juntas y usa credenciales de tu base.
# DB_URL=jdbc:postgresql://localhost:5433/eduplan_db
# DB_USER=eduplan
# DB_PASSWORD=
# Opcional en desarrollo: JWT_SECRET se genera en memoria por el orquestador.
# Obligatorio en producción: Base64 de al menos 32 bytes aleatorios.
# JWT_SECRET=
# JWT_EXPIRATION_MS=86400000
# Administración opcional: sin estos tokens los endpoints siguen denegados.
# DATA_SYNC_ADMIN_TOKEN=
# PROGRAM_LINKS_ADMIN_TOKEN=
# DATA_INTEGRATION_BASE_URL=http://localhost:3001
# DATA_INTEGRATION_PAGE_SIZE=100
# DATA_INTEGRATION_MAX_PAGES=5000
# DB_BASELINE_EXISTING=false
# En producción usa secretos del entorno de despliegue, no archivos versionados.
