# Configuración del stack completo: docker compose up -d --build --wait
# Copia a .env y completa los secretos; nunca subas .env al repositorio.
POSTGRES_DB=eduplan_db
POSTGRES_USER=eduplan
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
# Base64 de al menos 32 bytes aleatorios; conserva el mismo valor entre arranques.
JWT_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Logos de instituciones: clave PUBLICABLE pk_ de Logo.dev.
VITE_LOGO_DEV_TOKEN=
# Fotografías: claves privadas, solo para el servicio de catálogo.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
