# Opcional: overrides de producción con APIs en otro origen (requieren CORS).
# Desarrollo normal usa el proxy de Vite; no copies este archivo.
# Solo instituciones: VITE_DATA_INTEGRATION_URL=https://catalogo.example.org
# Solo enlaces oficiales: VITE_BACKEND_URL=https://api.example.org
# Desarrollo avanzado: destinos del proxy, variables del proceso Vite.
# EDUPLAN_CATALOG_URL=http://localhost:3001
# EDUPLAN_BACKEND_URL=http://localhost:8080

# Logos: copia solo esta variable a frontend/.env.local, o expórtala antes de Vite.
# Clave PUBLICABLE de Logo.dev (pk_); nunca una clave secreta sk_.
# Sin clave válida, se usan los logos locales o el icono genérico.
VITE_LOGO_DEV_TOKEN=
